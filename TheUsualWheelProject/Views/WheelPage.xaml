<!-- In Views/WheelListPage.xaml -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TheUsualWheelProject.ViewModels"
             xmlns:models="clr-namespace:TheUsualWheelProject.Models"
             x:Class="TheUsualWheelProject.Views.WheelPage"
             x:DataType="viewmodels:WheelListViewModel"
             Title="Wheels">

    <CollectionView ItemsSource="{Binding Wheels}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Wheel">
                <VerticalStackLayout Padding="10">
                    <Label Text="{Binding Name}" FontSize="18" />
                    <Label Text="{Binding Description}" FontSize="14" />
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>