@page "/wheel/{Id:int}"
@implements IDisposable
@inject WheelViewModel ViewModel
@inject IDialogService DialogService

@if (ViewModel.CurrentWheel == null)
{
    <p>Wheel not found.</p>
}
else
{
    <!-- Preview Wheel -->
    <WheelVisualizer 
        Items="ViewModel.ActiveSessionMovies.ToList()" 
        IsPreviewMode="true" 
        SlicePalette="ViewModel.CurrentWheel.Configuration.SliceColors" />
    
    <div class="d-flex justify-center mt-4">
        <button class="start-session-button" @onclick="OpenSessionDialog">
            <span class="start-session-text">Start Wheel Session</span>
         </button>
    </div>

    <!-- Collapsible Management Panels -->
    <MudExpansionPanels MultiExpansion="true" Class="mt-6">

        <!-- Panel: Your Collection (The Movie List UI) -->
        <MudExpansionPanel Text="Movie Collection" Expanded="true" Icon="@Icons.Material.TwoTone.LocalMovies">
            <WheelMovieCollection />
        </MudExpansionPanel>

        <!-- Future Panel: Wheel Settings -->
        <MudExpansionPanel Text="Wheel Settings" Icon="@Icons.Material.Filled.Settings">
            <div class="settings-container">
                
                <!-- WHEEL DETAILS -->
                <div class="settings-section">
                    <h6 class="settings-header">WHEEL DETAILS</h6>
                    
                    <div class="settings-field">
                        <label>Wheel Title</label>
                        <MudTextField @bind-Value="ViewModel.CurrentWheel.Name" 
                                      @bind-Value:after="() => ViewModel.SaveWheelConfigAsync()"
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense"
                                      Class="sleek-input" />
                    </div>

                    <div class="settings-field">
                        <label>Description</label>
                        <MudTextField @bind-Value="ViewModel.CurrentWheel.Description" 
                                      @bind-Value:after="() => ViewModel.SaveWheelConfigAsync()"
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense"
                                      Class="sleek-input" />
                    </div>
                </div>

                <MudDivider Class="my-4 subtle-divider" />

                <!-- GAMEPLAY OPTIONS -->
                <div class="settings-section">
                    <h6 class="settings-header">SPIN SETTINGS</h6>
                    
                    <div class="settings-row">
                        <label>Last Movie Standing Mode (non functional)</label>
                        <MudSwitch @bind-Value="ViewModel.CurrentWheel.Configuration.IsLastMovieStanding" 
                                   @bind-Value:after="() => ViewModel.SaveWheelConfigAsync()"
                                   Color="Color.Warning" />
                    </div>

                    <div class="settings-field mt-2">
                        <div class="d-flex justify-space-between w-100 mb-1">
                            <label class="mb-0">Spin Duration(non functional)</label>
                            <span class="accent-text">@ViewModel.CurrentWheel.Configuration.SpinDurationSeconds sec</span>
                        </div>
                        
                        <MudSlider @bind-Value="ViewModel.CurrentWheel.Configuration.SpinDurationSeconds" 
                                   @bind-Value:after="() => ViewModel.SaveWheelConfigAsync()" 
                                   Min="2" Max="10" Step="1" 
                                   Color="Color.Warning" 
                                   Class="sleek-slider my-0" />
                                   
                        <div class="d-flex justify-space-between w-100 mt-1 px-1">
                            <span style="font-size: 0.75rem; color: var(--text-muted);">2 sec</span>
                            <span style="font-size: 0.75rem; color: var(--text-muted);">10 sec</span>
                        </div>
                    </div>

                </div>

                <MudDivider Class="my-4 subtle-divider" />

                <!-- AESTHETICS -->
                <div class="settings-section">
                    <h6 class="settings-header">AESTHETICS</h6>

                    <div class="settings-row">
                        <label>Allow Slice Duplication (non functional)</label>
                        <MudSwitch @bind-Value="ViewModel.CurrentWheel.Configuration.AllowDuplicates" 
                                   @bind-Value:after="() => ViewModel.SaveWheelConfigAsync()"
                                   Color="Color.Warning" />
                    </div>
                    

                    <div class="settings-field mt-4">
                        <label>Slice Colors</label>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            @for (int i = 0; i < ViewModel.CurrentWheel.Configuration.SliceColors.Count; i++)
                            {
                                int index = i;
                                string currentColor = ViewModel.CurrentWheel.Configuration.SliceColors[index];

                                <div class="color-palette-box" 
                                     style="background-color: @currentColor;"
                                     @onclick="() => _editingColorIndex = index">
                                </div>
                            }
                            <div class="add-color-box"
                                 @onclick="() => 
                                 {
                                     ViewModel.AddSliceColor();
                                     _editingColorIndex = ViewModel.CurrentWheel.Configuration.SliceColors.Count - 1;
                                 }">
                                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                            </div>
                        </div>

                        <!-- Color Picker Sub Panel -->
                        @if (_editingColorIndex.HasValue && _editingColorIndex.Value < ViewModel.CurrentWheel.Configuration.SliceColors.Count)
                        {
                            <MudPaper Class="pa-4 mt-2 color-picker-panel" Elevation="0">
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <MudText Typo="Typo.subtitle2">Editing Color @(_editingColorIndex.Value + 1)</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => _editingColorIndex = null" />
                                </div>
                                <MudColorPicker 
                                    PickerVariant="PickerVariant.Static" 
                                    ColorPickerView="ColorPickerView.Spectrum" 
                                    Value="@ViewModel.CurrentWheel.Configuration.SliceColors[_editingColorIndex.Value]"
                                    ValueChanged="(MudBlazor.Utilities.MudColor newColor) => 
                                    {
                                        ViewModel.CurrentWheel.Configuration.SliceColors[_editingColorIndex.Value] = newColor.Value;
                                        _ = ViewModel.SaveWheelConfigAsync();
                                    }" 
                                    Elevation="0"
                                    DisableAlpha="true" />
                                <div class="d-flex justify-end mt-2">
                                    <MudButton 
                                        Color="Color.Error" 
                                        Variant="Variant.Text"
                                        StartIcon="@Icons.Material.Filled.Delete"
                                        Disabled="ViewModel.CurrentWheel.Configuration.SliceColors.Count <= 2"
                                        OnClick="() => {
                                            ViewModel.RemoveSliceColor(ViewModel.CurrentWheel.Configuration.SliceColors[_editingColorIndex.Value]);
                                            _editingColorIndex = null;
                                        }">
                                        Delete Color
                                    </MudButton>
                                </div>
                            </MudPaper>
                        }
                    </div>
                </div>

                <MudDivider Class="my-4 subtle-divider" />

                <!-- AUDIO -->
                <div class="settings-section">
                    <h6 class="settings-header">AUDIO</h6>
                    
                    <div class="settings-field">
                        <label>Spin Soundtrack(non functional)</label>
                        <div class="audio-selection-box mt-2">
                            <div class="d-flex align-center gap-3">
                                <MudIcon Icon="@Icons.Material.Filled.MusicNote" Color="Color.Warning" />
                                <span>@(string.IsNullOrWhiteSpace(ViewModel.CurrentWheel.Configuration.AudioTrack) ? "Default" : ViewModel.CurrentWheel.Configuration.AudioTrack)</span>
                            </div>
                            <!-- Currently functionless standard track selector intent -->
                            <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small">CHANGE</MudButton>
                        </div>
                    </div>
                </div>

            </div>
        </MudExpansionPanel>

        <!-- Panel: Movie Details -->
        <MudExpansionPanel Text="Movie Details" Icon="@Icons.Material.Filled.Info">
            @* Should be a component that has more expansion panels, one for each movie *@
            @if (ViewModel.IsEnriching)
            {
                <p>Fetching missing details from TMDB...</p>
            }
            @if (ViewModel.AllWheelMovies == null || !ViewModel.AllWheelMovies.Any())
            {
                <p>No movies found for this wheel.</p>
            }
            else
            {
                <div style="display:flex; flex-direction:column; gap:16px;">
                    @foreach (WheelMovieItem item in ViewModel.AllWheelMovies)
                    {
                        <WheelMovieDetailsCard Movie="item.Movie" />
                    }
                </div>
            }
        </MudExpansionPanel>

        <!-- Future Panel: Stats -->
        @* https://mudblazor.com/components/timeline, cool for displaying history *@
        @* Could show average movie length, total combined runtime, average remainig rating *@
        <MudExpansionPanel Text="Stats & Insights" Icon="@Icons.Material.Filled.BarChart">
            <p>Visual stats on your watched movie history.</p>
            <p>Charts on average ratings, genres, avg length, avg rating etc.</p>
            <p>But for now, just list watched movies with dates:</p>
            
            @foreach (WheelMovieItem item in ViewModel.WatchedMovies)
            {
                <p>@item.Movie.Title - Watched on @item.WheelMovie.WatchedDate</p>
            }
        </MudExpansionPanel>
        

    </MudExpansionPanels>
}

@code {
    [Parameter] 
    public int Id { get; set; }
    private List<string> MovieTitles => ViewModel.AllWheelMovies?.Select(m => m.Movie.Title).ToList() ?? new List<string>();
    private string? _errorMessage;
    private int? _editingColorIndex = null;

    protected override async Task OnInitializedAsync()
    {
        ViewModel.DataUpdated += HandleDataUpdated;
        ViewModel.PropertyChanged += HandlePropertyChanged;
        try
        {
            await ViewModel.LoadWheelAsync(Id); 
            _ = Task.Run(async () => 
            {
                try
                {
                    // await ViewModel.EnrichMoviesBackgroundAsync();
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    _errorMessage = $"Background error: {ex.Message}";
                    Console.WriteLine(ex);
                    await InvokeAsync(StateHasChanged);
                }
            });
        }
        catch (Exception ex)
        {
            _errorMessage = $"Initialization error: {ex.Message}";
            Console.WriteLine(ex);
        }
    }

    private async Task HandleWheelLanded(string selectedTitle)
    {
        // Find selected movie by title, mark as eliminated, update wheel state
        // await ViewModel.HandleWheelSelectionAsync(selectedTitle);
    }

    private void HandleDataUpdated()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandlePropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        HandleDataUpdated();
    }

    public void Dispose()
    {
        ViewModel.DataUpdated -= HandleDataUpdated;
        ViewModel.PropertyChanged -= HandlePropertyChanged;
    }

    private Task OpenSessionDialog()
    {
        DialogOptions options = new DialogOptions {CloseOnEscapeKey = true, FullScreen =true, CloseButton = true };
        return DialogService.ShowAsync<WheelSessionDialog>("Wheel Session", options);
    }
}