@implements IDisposable
@inject IDialogService DialogService

<div class="collection-container">
    <div class="collection-header mt-4 mb-4">
        <div class="collection-actions d-flex flex-wrap gap-2 align-center w-100">
            
            <div class="movie-count-badge">
                <span class="count-number">@ActiveMovies.Count()</span>
                <span class="count-label">movies</span>
            </div>

            <MudSpacer />
            
            <MudSwitch Value="_isMassRemoveMode" 
                       ValueChanged="(bool val) => OnMassRemoveModeChanged(val)" 
                       Color="Color.Error" 
                       Label="Remove Multiple" 
                       LabelPlacement="Placement.Start"
                       Class="my-0" />

            @if (_isMassRemoveMode && _selectedForRemoval.Any())
            {
                <button class="action-btn action-btn-danger" @onclick="ExecuteMassRemove">
                    <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                    REMOVE (@_selectedForRemoval.Count)
                </button>
            }

        </div>
    </div>

    <!-- ACTIVE MOVIES PANEL -->
    <MudExpansionPanels Class="mt-2" Elevation="0">
        <MudExpansionPanel Expanded="true">
            <TitleContent>
                <div class="d-flex align-center w-100">
                    <MudIcon Icon="@Icons.Material.Filled.PlayCircleOutline" Size="Size.Small" Color="Color.Primary" Class="mr-2" />
                    <span class="panel-header-text">
                        ACTIVE MOVIES
                    </span>
                </div>
            </TitleContent>
            <ChildContent>
                <div class="movie-list">
                    @foreach (WheelMovieItem item in ActiveMovies)
                    {
                        <MovieCard Title="@item.Movie.Title"
                                   Year="@item.Movie.Year.ToString()"
                                   Director="@item.Movie.Director"
                                   PosterUrl="@item.Movie.PosterUrl"
                                   IsSelected="@_selectedForRemoval.Contains(item)"
                                   OnCardClick="@(() => { if (_isMassRemoveMode) ToggleMovieSelection(item); })">
                            <RightActions>
                                @if (_isMassRemoveMode)
                                {
                                    <MudIcon Icon="@(_selectedForRemoval.Contains(item)
                                                        ? Icons.Material.Filled.CheckCircle
                                                        : Icons.Material.Filled.RadioButtonUnchecked)"
                                             Color="@(_selectedForRemoval.Contains(item) ? Color.Error : Color.Default)" />
                                }
                                else
                                {
                                    <MudMenu Icon="@Icons.Material.Rounded.MoreVert"
                                             AnchorOrigin="Origin.BottomRight"
                                             TransformOrigin="Origin.TopRight">
                                        <MudMenuItem Icon="@Icons.Material.Filled.Info"
                                                     IconColor="Color.Primary"
                                                     OnClick="() => { /* TODO: Show movie details */ }">
                                            View Details
                                        </MudMenuItem>
                                        <MudDivider />
                                        <MudMenuItem Icon="@Icons.Material.Outlined.RemoveRedEye"
                                                     OnClick="@(async () => { await Task.Delay(50); await ViewModel.ToggleMovieWatchedStatusAsync(item.WheelMovie.Id, true); })">
                                            Mark as Watched
                                        </MudMenuItem>
                                        <MudDivider />
                                        <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                                     IconColor="Color.Error"
                                                     OnClick="@(async () =>
                                                     {
                                                         if (await ConfirmAsync("Remove movie?", $"Remove {item.Movie.Title} from this wheel?"))
                                                         {
                                                             await ViewModel.RemoveWheelMovieAsync(item.WheelMovie.Id);
                                                         }
                                                     })">
                                            Remove Movie
                                        </MudMenuItem>
                                    </MudMenu>
                                }
                            </RightActions>
                        </MovieCard>
                    }
                </div>
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>

    <!-- ADD MOVIE BUTTON (Sandwiched) -->
    <div class="add-movie-btn mt-3 mb-3" @onclick="() => _isSearchDrawerOpen = true">
        <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="mr-2" />
        <span>ADD MOVIE</span>
    </div>

    <!-- WATCHED MOVIES PANEL -->
    <MudExpansionPanels Class="mb-4" Elevation="0">
        <MudExpansionPanel Expanded="false">
            <TitleContent>
                <div class="d-flex align-center w-100">
                    <MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Small" Color="Color.Primary" Class="mr-2" />
                    <span class="panel-header-text">
                        WATCHED MOVIES (@WatchedMovies.Count())
                    </span>
                </div>
            </TitleContent>
            <ChildContent>
                <div class="movie-list">
                    @foreach (WheelMovieItem item in WatchedMovies)
                    {
                        <MovieCard Title="@item.Movie.Title"
                                   Year="@item.Movie.Year.ToString()"
                                   Director="@item.Movie.Director"
                                   PosterUrl="@item.Movie.PosterUrl"
                                   IsWatched="true"
                                   IsSelected="@_selectedForRemoval.Contains(item)"
                                   OnCardClick="@(() => { if (_isMassRemoveMode) ToggleMovieSelection(item); })">
                            <RightActions>
                                @if (_isMassRemoveMode)
                                {
                                    <MudIcon Icon="@(_selectedForRemoval.Contains(item)
                                                        ? Icons.Material.Filled.CheckCircle
                                                        : Icons.Material.Filled.RadioButtonUnchecked)"
                                             Color="@(_selectedForRemoval.Contains(item) ? Color.Error : Color.Default)" />
                                }
                                else
                                {
                                    <MudMenu Icon="@Icons.Material.Rounded.MoreVert"
                                             AnchorOrigin="Origin.BottomRight"
                                             TransformOrigin="Origin.TopRight">
                                        <MudMenuItem Icon="@Icons.Material.Filled.RemoveRedEye"
                                                     OnClick="@(async () => { await Task.Delay(50); await ViewModel.ToggleMovieWatchedStatusAsync(item.WheelMovie.Id, false); })">
                                            Unmark as Watched
                                        </MudMenuItem>
                                        <MudDivider />
                                        <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                                    IconColor="Color.Error"
                                                    OnClick="@(async () =>
                                                    {
                                                        if (await ConfirmAsync("Remove movie?", $"Remove \"{item.Movie.Title}\" from this wheel?"))
                                                        {
                                                            await ViewModel.RemoveWheelMovieAsync(item.WheelMovie.Id);
                                                        }
                                                    })">
                                            Remove Movie
                                        </MudMenuItem>
                                    </MudMenu>
                                }
                            </RightActions>
                        </MovieCard>
                    }
                </div>
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
</div>

@if (_isSearchDrawerOpen)
{
    <MudDrawer
        @bind-Open="_isSearchDrawerOpen"
        Anchor="Anchor.Bottom"
        Variant="DrawerVariant.Temporary"
        Elevation="24"
        Height="80%"
        Class="search-drawer custom-bottom-drawer">
        
        <div class="drawer-handle"
             @ontouchstart="HandleTouchStart"
             @ontouchmove="HandleTouchMove"
             @ontouchend="HandleTouchEnd"
             @ontouchcancel="HandleTouchCancel">
        </div>

        <MudDrawerHeader Class="search-drawer-header">
            <MudText Typo="Typo.h5" Class="search-drawer-title">
                Search Movies
            </MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseSearchDrawer" />
        </MudDrawerHeader>

        <div class="pa-4 drawer-scroll-area">
            <SharedMovieSearch TargetWheelId="ViewModel.CurrentWheel?.Id" />
        </div>
    </MudDrawer>
}

@code {
    [Inject] private TheUsualWheelProject.ViewModels.WheelViewModel ViewModel { get; set; } = default!;

    private bool _isSearchDrawerOpen = false;
    private bool _isMassRemoveMode = false;
    private HashSet<WheelMovieItem> _selectedForRemoval = new();

    private IEnumerable<WheelMovieItem> ActiveMovies =>
        ViewModel.ActiveSessionMovies ?? Enumerable.Empty<WheelMovieItem>();

    private IEnumerable<WheelMovieItem> WatchedMovies =>
        ViewModel.WatchedMovies ?? Enumerable.Empty<WheelMovieItem>();

    protected override void OnInitialized()
    {
        ViewModel.DataUpdated += StateHasChanged;
    }

    public void Dispose()
    {
        ViewModel.DataUpdated -= StateHasChanged;
    }

    private void ToggleMassRemoveMode()
    {
        _isMassRemoveMode = !_isMassRemoveMode;
        if (!_isMassRemoveMode)
        {
            _selectedForRemoval.Clear();
        }
    }

    private void ToggleMovieSelection(WheelMovieItem item)
    {
        if (_selectedForRemoval.Contains(item))
        {
            _selectedForRemoval.Remove(item);
        }
        else
        {
            _selectedForRemoval.Add(item);
        }
    }

    private async Task ExecuteMassRemove()
    {
        if (!_selectedForRemoval.Any())
            return;

        if (!await ConfirmAsync(
            title: "Remove multiple movies?",
            message: $"Remove {_selectedForRemoval.Count} selected movies from this wheel?",
            detail: "This action cannot be undone."))
        {
            return;
        }

        List<int>? idsToRemove = _selectedForRemoval.Select(i => i.WheelMovie.Id).ToList();
        await ViewModel.RemoveWheelMoviesAsync(idsToRemove);

        _selectedForRemoval.Clear();
        _isMassRemoveMode = false;
    }

    private async Task<bool> ConfirmAsync(string title, string message, string? detail = null)
    {
        DialogParameters? parameters = new DialogParameters
        {
            { "Title", title },
            { "Message", message },
            { "Detail", detail ?? "This action cannot be undone." },
            { "ConfirmText", "Continue" },
            { "CancelText", "Cancel" },
            { "ConfirmColor", Color.Error }
        };

        DialogOptions? options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        IDialogReference? dialog = await DialogService.ShowAsync<ConfirmDialog>(title, parameters, options);
        DialogResult? result = await dialog.Result;
        return result is { Canceled: false, Data: bool ok } && ok;
    }

    private double? _touchStartY;

    private void HandleTouchStart(Microsoft.AspNetCore.Components.Web.TouchEventArgs e)
    {
        _touchStartY = e.Touches.FirstOrDefault()?.ClientY;
    }

    private void HandleTouchMove(Microsoft.AspNetCore.Components.Web.TouchEventArgs e)
    {
        if (_touchStartY == null)
        {
            return;
        }

        var currentY = e.Touches.FirstOrDefault()?.ClientY;
        if (!currentY.HasValue)
        {
            return;
        }

        var deltaY = currentY.Value - _touchStartY.Value;
        if (deltaY > 60)
        {
            CloseSearchDrawer();
        }
    }

    private void HandleTouchEnd(Microsoft.AspNetCore.Components.Web.TouchEventArgs e)
    {
        if (_touchStartY == null)
        {
            return;
        }

        var touchEndY = e.ChangedTouches.FirstOrDefault()?.ClientY;
        if (touchEndY.HasValue)
        {
            var deltaY = touchEndY.Value - _touchStartY.Value;
            if (deltaY > 60)
            {
                CloseSearchDrawer();
            }
        }

        _touchStartY = null;
    }

    private void HandleTouchCancel(Microsoft.AspNetCore.Components.Web.TouchEventArgs e)
    {
        _touchStartY = null;
    }

    private void CloseSearchDrawer()
    {
        _isSearchDrawerOpen = false;
        StateHasChanged();
    }

    private void OnMassRemoveModeChanged(bool value)
    {
        _isMassRemoveMode = value;
        if (!_isMassRemoveMode)
        {
            _selectedForRemoval.Clear();
        }
    }
}