@page "/movies"

@inject MovieSearchViewModel ViewModel

<h1>Movie Search</h1>

<div class="movie-search">
	<input @bind="ViewModel.SearchQuery" placeholder="Enter movie title..." />
	<button @onclick="ViewModel.SearchMoviesAsync">Search</button>
</div>

@if (ViewModel.IsSearching)
{
	<p>Searching TMDB...</p>
}
else if (ViewModel.SearchResults != null && ViewModel.SearchResults.Any())
{
	<h2>Results</h2>
	<div class="movie-results">
		@foreach (var movie in ViewModel.SearchResults)
		{
			<MovieSearchCard movie="movie" />
		}
	</div>
}
else if (ViewModel.HasSearched)
{
	<p>No results found.</p>
}