@page "/wheellist"

@inject WheelListViewModel ViewModel

<div class="welcome-back-message">
    @if (_showWelcomeBack)
    {
        <WelcomeBackPopup
            MovieTitle="@ViewModel.LastWatched.MovieTitle"
            WheelName="@ViewModel.LastWatched.WheelName"
            WatchedDate="@ViewModel.LastWatched.WatchedDate"
            OnClose="HideWelcomeBack" />
    }
</div>

<div class="wheel-list-header">
    <div class="wheel-list-header-top">
        <h1>Your Wheels</h1>
        <p>Total wheels: @(ViewModel.Wheels?.Count() ?? 0)</p>
    </div>

    <button class="add-wheel-button" @onclick="ShowAddModal">
        <MudIcon Icon="@Icons.Material.Outlined.AddCircle" Size="Size.Medium" Class="add-wheel-icon" />
        <span class="add-wheel-text">Add New Wheel</span>
    </button>

    <AddWheelModal
        IsVisible="@_showAddModal"
        OnClose="@HideAddModal"
        OnAddWheel="@HandleAddWheel" />

    <EditWheelModal
        IsVisible="@_showEditModal"
        CurrentName="@(_editingWheel?.Wheel.Name ?? string.Empty)"
        CurrentDescription="@_editingWheel?.Wheel.Description"
        OnClose="@HideEditModal"
        OnSave="@HandleSaveEdit" />
</div>

<div class="wheel-grid">
    @if (ViewModel.Wheels == null || !ViewModel.Wheels.Any())
    {
        <p>No wheels found.</p>
    }
    else
    {
        @foreach (WheelListViewModel.WheelCardInfo wheelInfo in ViewModel.Wheels)
        {
            <WheelCard
                WheelInfo="wheelInfo"
                OnEdit="HandleEditRequested"
                OnDelete="HandleDeleteRequested" />
        }
    }
</div>

@code {
    private bool _showAddModal = false;
    private bool _showEditModal = false;
    private bool _showWelcomeBack = true;
    private WheelListViewModel.WheelCardInfo? _editingWheel;

    private void ShowAddModal() => _showAddModal = true;
    private void HideAddModal() => _showAddModal = false;
    private void HideWelcomeBack() => _showWelcomeBack = false;

    private async Task HandleAddWheel((string Name, string Description) wheelData)
    {
        await ViewModel.AddWheelAsync(wheelData.Name, wheelData.Description);
        HideAddModal();
    }

    private Task HandleEditRequested(WheelListViewModel.WheelCardInfo wheelInfo)
    {
        _editingWheel = wheelInfo;
        _showEditModal = true;
        return Task.CompletedTask;
    }

    private async Task HandleDeleteRequested(WheelListViewModel.WheelCardInfo wheelInfo)
    {
        await ViewModel.DeleteWheelAsync(wheelInfo.Wheel.Id);
    }

    private void HideEditModal()
    {
        _showEditModal = false;
        _editingWheel = null;
    }

    private async Task HandleSaveEdit((string Name, string Description) data)
    {
        if (_editingWheel is null)
            return;

        await ViewModel.UpdateWheelAsync(_editingWheel.Wheel.Id, data.Name, data.Description);
        HideEditModal();
    }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadWheelAsync();
        await ViewModel.LoadLastWatchedWheelMovieAsync();
    }
}