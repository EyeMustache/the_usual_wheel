@page "/wheel/{id:int}"
@implements IDisposable

@inject WheelViewModel ViewModel

@if (ViewModel.CurrentWheel == null)
{
    <p>Wheel not found.</p>
}
else
{
    <h1>@ViewModel.CurrentWheel.Name</h1>
    @if (ViewModel.IsEnriching)
    {
        <p>Fetching missing details from TMDB...</p>
    }
    @if (ViewModel.WheelMovies == null || !ViewModel.WheelMovies.Any())
    {
        <p>No movies found for this wheel.</p>
    }
    else
    {
        <ul>
            @foreach (Movie movie in ViewModel.WheelMovies)
            {
                <li>
                    <strong>@movie.Title</strong> (@movie.Year)<br />
                    <em>Genre:</em> @movie.Genre<br />
                    <em>Director:</em> @movie.Director<br />
                    <em>Cast:</em> @movie.Cast<br />
                    <em>Duration:</em> @movie.DurationInMinutes min<br />
                    <em>TMDb Rating:</em> @movie.TmdbRating<br />
                    @if (!string.IsNullOrWhiteSpace(movie.Synopsis))
                    {
                        <em>Synopsis:</em> @movie.Synopsis<br />
                    }
                    @if (!string.IsNullOrWhiteSpace(movie.PosterUrl))
                    {
                        <img src="@movie.PosterUrl" alt="Poster for @movie.Title" style="height:100px;" />
                    }
                </li>
            }
        </ul>
    }
}

@code {
    [Parameter] public int id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ViewModel.DataUpdated += HandleDataUpdated;
        await ViewModel.LoadWheelAsync(id);
    }

    private void HandleDataUpdated()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ViewModel.DataUpdated -= HandleDataUpdated;
    }
}