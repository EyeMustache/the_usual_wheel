@page "/wheel/{id:int}"

@inject WheelViewModel ViewModel

@if (ViewModel.CurrentWheel == null)
{
    <p>Wheel not found.</p>
}
else
{
    <h1>@ViewModel.CurrentWheel.Name</h1>
    @if (ViewModel.WheelMovies == null || !ViewModel.WheelMovies.Any())
    {
        <p>No movies found for this wheel.</p>
    }
    else
    {
        <ul>
            @foreach (Movie movie in ViewModel.WheelMovies)
            {
                <li>@movie.Title</li>
            }
        </ul>
    }
}

@code {
    [Parameter] public int id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadWheelAsync(id);
    }
}