@page "/wheellist"

@inject WheelListViewModel ViewModel
@* Welcome back message with last watched info *@
@* Should be pop up at the top of the page, everything shifts down, can be closed with an x *@
@* But for now just shows the text *@
<div class="welcome-back">
    <h2>Welcome back!</h2>
    <p>Last movie watched: <strong>@ViewModel.LastWatched.MovieTitle</strong></p>
    <p>From wheel: <strong>@ViewModel.LastWatched.WheelName</strong></p>
    @if (ViewModel.LastWatched.WatchedDate.HasValue)
    {
        <p>Watched on: <strong>@ViewModel.LastWatched.WatchedDate.Value.ToString("MMMM dd, yyyy")</strong></p>
    }
</div>

<h1>All Wheels</h1>
<button @onclick="ShowAddModal">Add Wheel</button>
<AddWheelModal IsVisible="@_showAddModal" OnClose="@HideAddModal" OnAddWheel="@HandleAddWheel" />
<div class="wheel-grid">
    @if (ViewModel.Wheels == null || !ViewModel.Wheels.Any())
    {
        <p>No wheels found.</p>
    }
    else
    {
        @foreach (WheelListViewModel.WheelCardInfo wheelInfo in ViewModel.Wheels)
        {
            <WheelCard WheelInfo="wheelInfo" />
        }
    }
</div>

@code {
    private bool _showAddModal = false;

    private void ShowAddModal() => _showAddModal = true;
    private void HideAddModal() => _showAddModal = false;
    private async Task HandleAddWheel((string Name, string Description) wheelData)
    {
        await ViewModel.AddWheelAsync(wheelData.Name, wheelData.Description);
        HideAddModal();
    }
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadWheelAsync();
        await ViewModel.LoadLastWatchedWheelMovieAsync();
    }
}