@page "/movie/{tmdbId:int}"
@inject MovieViewModel ViewModel

<h1>Movie Details</h1>
@if (ViewModel.CurrentMovie == null)
{
    <p>Movie not found.</p>
}
else if (ViewModel.CurrentMovie is Movie dbMovie)
{
    <MovieDetailsCard DbMovie="dbMovie" />
}
else if (ViewModel.CurrentMovie is TmdbMovie tmdbMovie)
{
    <MovieDetailsCard TmdbMovie="tmdbMovie" />
}

@code {
    [Parameter] public int tmdbId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadMovieByTmdbIdAsync(tmdbId);
    }
}
