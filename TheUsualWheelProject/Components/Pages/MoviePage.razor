@page "/movie/{tmdbId:int}"
@inject MovieViewModel ViewModel

<h1>Movie Details</h1>
@if (ViewModel.CurrentMovie == null)
{
    <p>Movie not found.</p>
}
else
{
    <MovieDetailsCard Movie="ViewModel.CurrentMovie" />
}

@code {
    // Should add an add to wheel button here in the future.
    [Parameter] public int tmdbId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadMovieByTmdbIdAsync(tmdbId);
    }
}
