@inject WheelListViewModel WheelListViewModel
@inject WheelViewModel WheelViewModel
@inject MovieService MovieService
@inject WheelService WheelService
@inject ISnackbar Snackbar

<MudDialog Title="Add to wheel"
           Class="blur dialog-background"
           TitleClass="dialog-background-title"
           ContentClass="dialog-background-surface py-10"
           ActionsClass="dialog-background-surface">
    <DialogContent>
        @if (_isLoading)
        {
            @* class here needs to be changed because wtf is this *@
            <div class="d-flex justify-center my-4">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </div>
        }
        else
        {
            <MudList T="int" Dense="false" Class="px-0">
                @foreach (WheelListViewModel.WheelCardInfo wheelInfo in AvailableWheels)
                {
                    Models.Wheel? wheel = wheelInfo.Wheel;
                    <MudListItem T="int" OnClick="@(() => ToggleWheel(wheel))" Class="px-2">
                        <div class="d-flex align-center">
                            <MudCheckBox T="bool" 
                                         Value="@IsMovieInWheel(wheel.Id)" 
                                         ValueChanged="@((bool val) => ToggleWheel(wheel, val))"
                                         Color="Color.Primary" 
                                         Class="mr-3" />
                            <MudText>@wheel.Name</MudText>
                        </div>
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Text">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Movie? DbMovie { get; set; }
    [Parameter] public TmdbMovie? TmdbMovie { get; set; }

    private bool _isLoading = true;
    private HashSet<int> _activeWheelIds = new HashSet<int>();
    private IEnumerable<WheelListViewModel.WheelCardInfo> AvailableWheels => WheelListViewModel.Wheels;
    private Movie? _resolvedDbMovie;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        
        int? tmdbId = DbMovie?.TmdbId > 0 ? DbMovie.TmdbId : TmdbMovie?.TmdbId;
        if (tmdbId.HasValue)
        {
            object? movieOrTmdb = await MovieService.GetMovieOrTmdbMovieByTmdbIdAsync(tmdbId.Value);
            if (movieOrTmdb is Movie existingMovie)
            {
                _resolvedDbMovie = existingMovie;
                IEnumerable<int>? memberships = await WheelService.GetWheelIdsForMovieAsync(existingMovie.Id);
                foreach (int wId in memberships)
                {
                    _activeWheelIds.Add(wId);
                }
            }
        }

        _isLoading = false;
    }

    private bool IsMovieInWheel(int wheelId) => _activeWheelIds.Contains(wheelId);

    private async Task ToggleWheel(Models.Wheel wheel, bool? newValue = null)
    {
        bool currentlyInWheel = _activeWheelIds.Contains(wheel.Id);
        bool willBeInWheel = newValue ?? !currentlyInWheel;

        if (currentlyInWheel == willBeInWheel) return;

        try
        {
            if (willBeInWheel)
            {
                await WheelViewModel.AddMovieToTargetWheelAsync(DbMovie ?? _resolvedDbMovie, TmdbMovie, wheel.Id);
                _activeWheelIds.Add(wheel.Id);
                
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Add(message: $"Added to {wheel.Name}", Severity.Success);
            }
            else
            {
                // Ensure we have the local movie ID before removing
                if (_resolvedDbMovie == null && TmdbMovie != null)
                {
                    object? movieOrTmdb = await MovieService.GetMovieOrTmdbMovieByTmdbIdAsync(TmdbMovie.TmdbId);
                    if (movieOrTmdb is Movie m) _resolvedDbMovie = m;
                }

                if (_resolvedDbMovie != null)
                {
                    await WheelService.RemoveMovieFromWheelAsync(_resolvedDbMovie.Id, wheel.Id);
                    
                    if (WheelViewModel.CurrentWheel?.Id == wheel.Id)
                    {
                        await WheelViewModel.LoadWheelAsync(wheel.Id);
                    }
                }

                _activeWheelIds.Remove(wheel.Id);
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Add(message: $"Removed from {wheel.Name}", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating wheel: {ex.Message}", Severity.Error);
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(result: true));
}