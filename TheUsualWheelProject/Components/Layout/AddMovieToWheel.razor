@inject WheelViewModel WheelViewModel
@inject WheelListViewModel WheelListViewModel
@inject ISnackbar Snackbar

<button class="add-movie-button"
        type="button"
        @onclick="HandleAddButtonClick"
        @onclick:stopPropagation="true"
        disabled="@IsButtonDisabled"
        aria-label="Add movie to wheel">
    <MudIcon Icon="@ButtonIcon" />
</button>

@if (showSelector)
{
    <div class="wheel-selector-modal">
        <select @bind="selectedWheelId">
            @foreach (Models.Wheel wheel in Wheels)
            {
                <option value="@wheel.Id">@wheel.Name</option>
            }
        </select>
        <button @onclick="AddMovieToSelectedWheel">Confirm</button>
        <button @onclick="Cancel">Cancel</button>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-message">@errorMessage</div>
        }
    </div>
}

@code {
    [Parameter] public Models.Movie? DbMovie { get; set; }
    [Parameter] public Models.TmdbMovie? TmdbMovie { get; set; }
    [Parameter] public bool IsDisabled { get; set; } = false;
    [Parameter] public int? TargetWheelId { get; set; }

    private IEnumerable<Models.Wheel> Wheels => WheelListViewModel.AvailableWheels;
    private bool showSelector = false;
    private int selectedWheelId;
    private string? errorMessage;
    private bool _isAdding = false;

    private IEnumerable<Models.WheelMovieItem> WheelMovies => WheelViewModel.AllWheelMovies;
    private int? CurrentWheelId => WheelViewModel.CurrentWheel?.Id;

    private bool IsAlreadyAdded =>
        TargetWheelId.HasValue
        && TargetWheelId == CurrentWheelId
        && GetMovieTmdbId() is int tmdbId
        && WheelMovies.Any(wm => wm.Movie.TmdbId == tmdbId);

    private bool IsButtonDisabled => IsDisabled || _isAdding || IsAlreadyAdded;

    private string ButtonIcon => IsAlreadyAdded
        ? Icons.Material.Filled.Check
        : Icons.Material.Filled.Add;

    private int? GetMovieTmdbId()
    {
        if (DbMovie != null && DbMovie.TmdbId != 0) return DbMovie.TmdbId;
        if (TmdbMovie != null) return TmdbMovie.TmdbId;
        return null;
    }

    private void ShowWheelSelector()
    {
        showSelector = true;
        selectedWheelId = TargetWheelId ?? Wheels.FirstOrDefault()?.Id ?? 0;
    }

    private void Cancel()
    {
        showSelector = false;
        errorMessage = null;
    }

    private async Task AddMovieRapidFire()
    {
        if (!TargetWheelId.HasValue) return;

        _isAdding = true;
        try
        {
            var result = await WheelViewModel.AddMovieToTargetWheelAsync(DbMovie, TmdbMovie, TargetWheelId.Value);
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add($"Successfully added {result.MovieTitle} to {result.WheelName}!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isAdding = false;
        }
    }

    private async Task AddMovieToSelectedWheel()
    {
        errorMessage = null;
        _isAdding = true;

        try
        {
            (string MovieTitle, string WheelName) result =
                await WheelViewModel.AddMovieToTargetWheelAsync(DbMovie, TmdbMovie, selectedWheelId);

            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add($"Successfully added {result.MovieTitle} to {result.WheelName}!", Severity.Success);
        }
        catch (Exception ex)
        {
            string movieTitle = DbMovie?.Title ?? TmdbMovie?.Title ?? "movie";
            errorMessage = $"Error adding movie to wheel: {ex.Message}";
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add($"Error adding {movieTitle}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isAdding = false;
            showSelector = false;
            StateHasChanged();
        }
    }

    private async Task HandleAddButtonClick()
    {
        if (IsAlreadyAdded)
        {
            return;
        }

        if (TargetWheelId.HasValue)
        {
            await AddMovieRapidFire();
        }
        else
        {
            ShowWheelSelector();
        }
    }
}