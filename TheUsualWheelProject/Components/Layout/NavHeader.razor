@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject WheelService WheelService

<MudAppBar Fixed="true" Elevation="1" Style="background: var(--bg-navbar); border-bottom: 1px solid rgba(255, 164, 0, 0.18);">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBackIos" Color="Color.Primary" OnClick="GoBack" />
    <MudSpacer />
    <MudText Typo="Typo.h6" Color="Color.Primary" Style="font-weight: 600;">@PageTitle</MudText>
    <MudSpacer />
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Primary" OnClick="ToggleMenu" />
</MudAppBar>

@if (isMenuOpen)
{
    <NavSidebar OnClose="CloseMenu" />
}

@code {
    private string PageTitle { get; set; } = "The Usual Wheel";
    private bool isMenuOpen = false;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        await UpdatePageTitleAsync(Navigation.Uri);
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await UpdatePageTitleAsync(e.Location);
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdatePageTitleAsync(string uri)
    {
        string path = Navigation.ToBaseRelativePath(uri).TrimEnd(trimChar: '/');

        if (path.StartsWith("wheel/", StringComparison.OrdinalIgnoreCase))
        {
            string[]? segments = path.Split(separator: '/');
            if (segments.Length >= 2 && int.TryParse(segments[1], out int wheelId))
            {
                Models.Wheel? wheel = await WheelService.GetWheelByIdAsync(wheelId);
                PageTitle = wheel?.Name ?? "Wheel Page";
                return;
            }
        }

        PageTitle = GetPageTitleFromPath(path);
    }

    private string GetPageTitleFromPath(string path)
    {
        return path switch
        {
            string p when p.StartsWith("add-wheel", StringComparison.OrdinalIgnoreCase) => "Add New Wheel",
            string p when p.StartsWith("edit-wheel", StringComparison.OrdinalIgnoreCase) => "Edit Wheel",
            string p when p.StartsWith("movies", StringComparison.OrdinalIgnoreCase) => "Movies",
            string p when p.StartsWith("actors", StringComparison.OrdinalIgnoreCase) => "Actors",
            string p when p.StartsWith("settings", StringComparison.OrdinalIgnoreCase) => "Settings",
            string p when p.StartsWith("about", StringComparison.OrdinalIgnoreCase) => "About",
            string p when p.StartsWith("wheel", StringComparison.OrdinalIgnoreCase) => "Wheel Page",
            _ => "The Usual Wheel"
        };
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void CloseMenu() => isMenuOpen = false;
    private void GoBack() => JS.InvokeVoidAsync("blazorGoBack");
}