<MovieCard Title="@TmdbMovie.Title" 
           Year="@TmdbMovie.Year.ToString()"
           Director="@TmdbMovie.Director"
           PosterUrl="@TmdbMovie.PosterUrl"
           OnCardClick="HandleClick">
    <RightActions>
        <AddMovieToWheel TmdbMovie="TmdbMovie" TargetWheelId="TargetWheelId" />
    </RightActions>
</MovieCard>

@code {
    [Parameter]
    public TmdbMovie TmdbMovie { get; set; } = default!;

    [Parameter]
    public int? TargetWheelId { get; set; }

    [Inject]
    public NavigationManager Navigation { get; set; } = default!;

    private void HandleClick()
    {
        Navigation.NavigateTo($"/movie/{TmdbMovie.TmdbId}");
    }
}