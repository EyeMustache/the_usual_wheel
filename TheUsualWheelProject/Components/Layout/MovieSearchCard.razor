@using TheUsualWheelProject.Models
@using Microsoft.AspNetCore.Components

<div class="movie-search-card" @onclick="HandleClick">
    <div class="movie-search-card-content">
        <div class="movie-search-card-image">
            @if (!string.IsNullOrWhiteSpace(movie.PosterUrl))
            {
                <img src="@movie.PosterUrl" alt="Poster for @movie.Title" />
            }
        </div>
        <div class="movie-search-card-info">
            <strong>@movie.Title</strong> (@movie.Year)<br />
            <span>Director: @movie.Director</span>
        </div>
        <AddMovieToWheel Movie="movie" />
    </div>
    <hr class="movie-search-card-separator" />
</div>

@code {
    [Parameter]
    public Movie movie { get; set; } = default!;

    [Inject]
    public NavigationManager Navigation { get; set; } = default!;

    private async Task HandleClick()
    {
        Navigation.NavigateTo($"/movie/{movie.TmdbId}");
    }
}