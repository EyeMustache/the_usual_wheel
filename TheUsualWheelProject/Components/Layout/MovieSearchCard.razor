<div class="movie-search-card" @onclick="HandleClick">
    <div class="movie-search-card-content">
        <div class="movie-search-card-image">
            @if (!string.IsNullOrWhiteSpace(TmdbMovie.PosterUrl))
            {
                <img src="@TmdbMovie.PosterUrl" alt="Poster for @TmdbMovie.Title" />
            }
        </div>
        <div class="movie-search-card-info">
            <strong>@TmdbMovie.Title</strong> (@TmdbMovie.Year)<br />
            <span>Director: @TmdbMovie.Director</span>
        </div>
        <AddMovieToWheel TmdbMovie="TmdbMovie" />
    </div>
    <hr class="movie-search-card-separator" />
</div>

@code {
    [Parameter]
    public TmdbMovie TmdbMovie { get; set; } = default!;

    [Inject]
    public NavigationManager Navigation { get; set; } = default!;

    private void HandleClick()
    {
        Navigation.NavigateTo($"/movie/{TmdbMovie.TmdbId}");
    }
}