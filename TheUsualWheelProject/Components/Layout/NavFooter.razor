@inject NavigationManager Navigation

<footer class="nav-footer">
    <button class= "nav_footer_btn" @onClick="() => Navigation.NavigateTo("/wheellist")">Wheels</button>
    <button class= "nav_footer_btn" @onClick="() => Navigation.NavigateTo("/")">Home</button>
    <button class= "nav_footer_btn" @onClick="() => Navigation.NavigateTo("/movies")">Movies</button>
</footer>

@code {
    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }
}