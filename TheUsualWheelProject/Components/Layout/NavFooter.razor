@inject NavigationManager Navigation

<MudAppBar Bottom="true" Fixed="true" Elevation="2" Style="background: var(--bg-navbar); border-top: 1px solid #444; z-index: var(--mud-zindex-appbar);">
    <MudSpacer />
    <MudButton Color="Color.Inherit" OnClick="@(() => NavigateTo("/actors"))">Actors</MudButton>
    <MudSpacer />
    <MudButton Color="Color.Inherit" OnClick="@(() => NavigateTo("/"))">Wheels</MudButton>
    <MudSpacer />
    <MudButton Color="Color.Inherit" OnClick="@(() => NavigateTo("/movies"))">Movies</MudButton>
    <MudSpacer />
</MudAppBar>

@* Would be cool to be able to swipe left and right to navigate as well
also would mean a smooth animation between pages, 
it would have to update the state oft hese icons to show which page you are on rn *@

@code {
    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }
}