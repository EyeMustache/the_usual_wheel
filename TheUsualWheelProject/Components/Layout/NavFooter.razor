@inject NavigationManager Navigation

<footer class="nav-footer">
    <button class="nav_footer_btn" @onclick="@(() => NavigateTo("/wheellist"))">Wheels</button>
    <button class="nav_footer_btn" @onclick="@(() => NavigateTo("/"))">Home</button>
    <button class="nav_footer_btn" @onclick="@(() => NavigateTo("/movies"))">Movies</button>
</footer>

@code {
    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }
}