@inject MovieDetailsViewModel ViewModel

<div class="movie-card">
    @if (ViewModel.DbMovie != null)
    {
        <strong>@ViewModel.DbMovie.Title</strong> <br />
        <em>Genre:</em> @ViewModel.DbMovie.Genre<br />
        <em>Director:</em> @ViewModel.DbMovie.Director<br />
        <em>Cast:</em> @ViewModel.DbMovie.Cast<br />
        <em>Duration:</em> @ViewModel.DbMovie.DurationInMinutes<br />
        <em>TMDb Rating:</em> @ViewModel.DbMovie.TmdbRating<br />
        <em>Synopsis:</em> @ViewModel.DbMovie.Synopsis<br />
        @if (!string.IsNullOrWhiteSpace(ViewModel.DbMovie.PosterUrl))
        {
            <img src="@ViewModel.DbMovie.PosterUrl" alt="Poster for @ViewModel.DbMovie.Title" style="height:100px;" />
        }
        <AddMovieToWheel DbMovie="ViewModel.DbMovie" />
    }
    else if (ViewModel.TmdbMovie != null)
    {
        <strong>@ViewModel.TmdbMovie.Title</strong> <br />
        <em>Genre:</em> @ViewModel.TmdbMovie.Genre<br />
        <em>Director:</em> @ViewModel.TmdbMovie.Director<br />
        <em>Cast:</em> @ViewModel.TmdbMovie.Cast<br />
        <em>Duration:</em> @ViewModel.TmdbMovie.DurationInMinutes<br />
        <em>TMDb Rating:</em> @ViewModel.TmdbMovie.TmdbRating<br />
        <em>Synopsis:</em> @ViewModel.TmdbMovie.Synopsis<br />
        @if (!string.IsNullOrWhiteSpace(ViewModel.TmdbMovie.PosterUrl))
        {
            <img src="@ViewModel.TmdbMovie.PosterUrl" alt="Poster for @ViewModel.TmdbMovie.Title" style="height:100px;" />
        }
        <AddMovieToWheel TmdbMovie="ViewModel.TmdbMovie" />
    }
    else
    {
        <div>Loading...</div>
    }
</div>

@code {
    [Parameter] public Movie? DbMovie { get; set; }
    [Parameter] public TmdbMovie? TmdbMovie { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadAsync(TmdbMovie?.TmdbId ?? DbMovie?.TmdbId ?? 0);
    }
}