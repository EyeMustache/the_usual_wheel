<div class="wheel-card" @onclick="HandleClick">
    <div class="wheel-card-left">
        <div class="wheel-mini" style="background:@WheelGradient;">
            <span>@WheelInfo.ActiveMovies</span>
        </div>
    </div>

    <div class="wheel-card-content">
        <div class="wheel-card-name">
            <h3>@WheelInfo.Wheel.Name</h3>
        </div>
        <div class="wheel-card-description">
            <p>@(WheelInfo.Wheel.Description ?? "No description")</p>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public ViewModels.WheelListViewModel.WheelCardInfo WheelInfo { get; set; } = default!;

    [Inject]
    public NavigationManager Navigation { get; set; } = default!;

    private int SliceCount => WheelInfo.ActiveMovies;

    private string WheelGradient
    {
        get
        {
            var c = WheelInfo.TotalMovies <= 0 ? 6 : WheelInfo.TotalMovies;
            var colors = new[] {
                "#f44336", "#ff9800", "#ffc107", "#8bc34a", "#00bcd4", "#3f51b5",
                "#9c27b0", "#e91e63", "#607d8b", "#795548"
            };
            var segments = Enumerable.Range(0, c)
                .Select(i => $"{colors[i % colors.Length]} {(i * 100.0 / c):0.##}% {((i+1) * 100.0 / c):0.##}%");
            return $"conic-gradient({string.Join(", ", segments)})";
        }
    }

    private void HandleClick()
    {
        Navigation.NavigateTo($"/wheel/{WheelInfo.Wheel.Id}");
    }
}