    }

    // debug stuff
    private void ConfirmRemoval()
    {
        if (pendingRemovalIndex.HasValue)
        {
            ViewModel.RemoveMovieAt(pendingRemovalIndex.Value, pendingFinalRotation);
            AnimatedRotation = ViewModel.CurrentRotation;
            pendingRemovalIndex = null;
            IsSpinPendingConfirmation = false;
            StateHasChanged();
        }
    }
}

