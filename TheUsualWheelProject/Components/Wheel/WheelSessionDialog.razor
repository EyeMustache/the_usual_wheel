@inject TheUsualWheelProject.ViewModels.WheelViewModel ViewModel
@inject TheUsualWheelProject.Services.AudioService AudioService
@inject NavigationManager Navigation
@implements IDisposable

@* 
KNOWN ISSUES:
The elimination dialog cancel completely breaks the session
Ignoring the pop up and pressing outside to close also breaks the session,  you can't spin anywhere anymore.
You can press X to back out of the session but the wheelpage isnt refreshed
The mudexpansionpanels are flexible, would like for them to be static


*@

<MudDialog Title="Wheel Session" MaxWidth="MaxWidth.Medium" FullWidth="true" Class="wheel-session-dialog">
    <DialogContent>
        <div class="session-layout">
            
            <WheelVisualizer
                Items="ViewModel.ActiveSessionMovies.ToList()"
                AnimatedRotation="AnimatedRotation"
                BaseRotation="ViewModel.CurrentRotation"
                IsAnimating="IsAnimating"
                IsPreviewMode="false"
                SpinDuration="ViewModel.CurrentWheel?.Configuration.SpinDurationSeconds ?? 5"
                SlicePalette="ViewModel.CurrentWheel?.Configuration.SliceColors ?? new()" />

            @* Session Controls & Timeline *@
            <MudExpansionPanels MultiExpansion="true" Class="mt-4 session-controls">
                

                @* Timeline panel *@
                <MudExpansionPanel Text="Elimination Timeline" Expanded="true" Icon="@Icons.Material.Filled.History">
                    <div class="timeline-scroll-container">
                        <MudTimeline TimelinePosition=TimelinePosition.Alternate TimelineOrientation=TimelineOrientation.Vertical Reverse="false">
                            @for (int i = 0; i < _eliminationHistory.Count; i++)
                            {
                                WheelMovieItem? item = _eliminationHistory[i];
                                
                                // The most recent item is the last one in the list
                                bool isLatest = i == _eliminationHistory.Count - 1;
                                
                                // Make the latest item "Warning" (lit up), others "Dark"
                                Color itemColor = isLatest ? Color.Warning : Color.Dark;
                                
                                // Even items go right (default text align), odd items go left (push text to the end)
                                Align textAlign = i % 2 == 0 ? Align.Start : Align.End;

                                <MudTimelineItem Color="@itemColor" Size="Size.Small" Variant="Variant.Filled">
                                    <ItemContent>
                                        <MudText Typo="Typo.body2" Align="@textAlign">
                                            @item.Movie.Title
                                        </MudText>
                                    </ItemContent>
                                </MudTimelineItem>
                            }
                        </MudTimeline>
                    </div>
                </MudExpansionPanel>

                @* Volume panel *@
                <MudExpansionPanel Text="Audio Settings" Icon="@Icons.Material.Filled.VolumeUp">
                    <div class="px-2">
                        <MudText Typo="Typo.subtitle2">Music Volume</MudText>
                        <MudSlider @bind-Value="BgmVolume"
                                   Min="0"
                                   Max="1"
                                   Step="0.05"
                                   Color="Color.Primary" />
                        <MudText Typo="Typo.caption" Class="mt-1 mb-2 d-block">@($"{BgmVolume:P0}")</MudText>

                        <MudText Typo="Typo.subtitle2" Class="mt-2">Tick Volume</MudText>
                        <MudSlider @bind-Value="TickVolume"
                                   Min="0"
                                   Max="1"
                                   Step="0.05"
                                   Color="Color.Secondary" />
                        <MudText Typo="Typo.caption" Class="mt-1 d-block">@($"{TickVolume:P0}")</MudText>
                    </div>
                </MudExpansionPanel>

            </MudExpansionPanels>

            @* Elimination Confirmation Dialog *@
            <MudDialog @bind-Visible="_showEliminationDialog">
                <TitleContent>
                    <MudText Typo="Typo.h6">Movie Eliminated</MudText>
                </TitleContent>
                <DialogContent>
                    <MudText>@_selectedMovie?.Movie.Title</MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        This movie will not be watched today.
                    </MudText>
                </DialogContent>
                <DialogActions>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmRemoval">Confirm</MudButton>
                    <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="CancelRemoval">Cancel</MudButton>
                </DialogActions>
            </MudDialog>

            @* Winner Dialog *@
            <MudDialog @bind-Visible="_showWinnerDialog">
                <TitleContent>
                    <MudText Typo="Typo.h6">Winner!</MudText>
                </TitleContent>
                <DialogContent>
                    <MudText>@_selectedMovie?.Movie.Title</MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        The wheel has spoken!
                    </MudText>
                </DialogContent>
                <DialogActions>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="FinishSessionAsync">Mark as Watched & View Details</MudButton>
                    <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="ResetAndClose">Keep Unwatched & Reset Session</MudButton>
                </DialogActions>
            </MudDialog>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="action-footer">
            @if (ViewModel.ActiveSessionMovies.Count > 1)
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" OnClick="Spin" Disabled="@IsAnimating">
                    @(IsAnimating ? "SPINNING..." : "SPIN THE WHEEL")
                </MudButton>
            }
            else if (ViewModel.ActiveSessionMovies.Count == 1)
            {
                <MudText Typo="Typo.h5" Color="Color.Success">
                    Winner: @ViewModel.ActiveSessionMovies[0].Movie.Title!
                </MudText>
            }
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private double AnimatedRotation = 0;
    private double _bgmVolume = 0.75;
    private double BgmVolume
    {
        get => _bgmVolume;
        set
        {
            if (_bgmVolume == value) return;
            _bgmVolume = value;
            AudioService.SetBgmVolume(value);
        }
    }
    
    private double _tickVolume = 0.75;
    private double TickVolume
    {
        get => _tickVolume;
        set
        {
            if (_tickVolume == value) return;
            _tickVolume = value;
            AudioService.SetTickVolume(value);
        }
    }
    private bool IsAnimating = false;
    private bool IsSpinPendingConfirmation = false;
    private int? pendingRemovalIndex = null;
    private double pendingFinalRotation = 0;
    private bool _showEliminationDialog;
    private bool _showWinnerDialog;
    private WheelMovieItem? _selectedMovie;
    private readonly List<WheelMovieItem> _eliminationHistory = new();

    protected override void OnInitialized()
    {
        ViewModel.DataUpdated += RefreshWheel;
        ViewModel.PropertyChanged += HandlePropertyChanged;

        _ = StartSessionAudioAsync();
    }

    private async Task StartSessionAudioAsync()
    {
        if (ViewModel.CurrentWheel == null) return;
        AudioService.SetBgmVolume(_bgmVolume);
        AudioService.SetTickVolume(_tickVolume);
        string bgmTrack = ViewModel.CurrentWheel.Configuration.AudioTrack;
        await AudioService.PlayBgmAsync(bgmTrack, loop: true);
    }

    public void Dispose()
    {

        AudioService.StopBgm();
        ViewModel.DataUpdated -= RefreshWheel;
        ViewModel.PropertyChanged -= HandlePropertyChanged;
    }

    private void RefreshWheel() => InvokeAsync(StateHasChanged);
    private void HandlePropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) => RefreshWheel();

    private async Task Spin()
    {
        int count = ViewModel.ActiveSessionMovies.Count;
        if (ViewModel.IsSpinning || count <= 1 || ViewModel.CurrentWheel == null) return;

        ViewModel.IsSpinning = true;

        (double finalRotation, int selectedIndex) = ViewModel.GetSpinResult(AnimatedRotation);

        pendingRemovalIndex = selectedIndex;
        pendingFinalRotation = finalRotation;
        IsSpinPendingConfirmation = true;
        _selectedMovie = ViewModel.ActiveSessionMovies[selectedIndex];

        double startRotation = AnimatedRotation;
        double endRotation = startRotation + finalRotation;
        
        IsAnimating = true;
        AnimatedRotation = endRotation;
        StateHasChanged(); 

        double durationMs = ViewModel.CurrentWheel.Configuration.SpinDurationSeconds * 1000;


        _ = StartTickSequence(startRotation, finalRotation, durationMs, count);

        await Task.Delay((int)durationMs); 

        IsAnimating = false;
        _showEliminationDialog = true;
        StateHasChanged();
    }

    private void ConfirmRemoval()
    {
        if (!pendingRemovalIndex.HasValue) return;

        if (_selectedMovie != null)
        {
            _eliminationHistory.Add(_selectedMovie);
        }

        ViewModel.RemoveMovieAt(pendingRemovalIndex.Value, pendingFinalRotation);
        pendingRemovalIndex = null;
        IsSpinPendingConfirmation = false;
        _showEliminationDialog = false;

        if (ViewModel.ActiveSessionMovies.Count == 1)
        {
            _selectedMovie = ViewModel.ActiveSessionMovies.FirstOrDefault();
            _showWinnerDialog = true;
        }

        AnimatedRotation = ViewModel.CurrentRotation;
        StateHasChanged();
    }

    private void CancelRemoval()
    {
        _showEliminationDialog = false;
        IsSpinPendingConfirmation = false;
        pendingRemovalIndex = null;
        _selectedMovie = null;
    }

    private async Task FinishSessionAsync()
    {
        if (_selectedMovie != null)
        {
            await ViewModel.ToggleMovieWatchedStatusAsync(_selectedMovie.WheelMovie.Id, true);
        }

        AudioService.StopBgm();
        ViewModel.RestoreSessionMovies();
        _showWinnerDialog = false;
        MudDialog.Close();

        if (_selectedMovie != null)
        {
            Navigation.NavigateTo($"/movie/{_selectedMovie.Movie.TmdbId}");
        }
    }

    private void ResetAndClose()
    {
        AudioService.StopBgm();
        ViewModel.RestoreSessionMovies();
        _showWinnerDialog = false;
        MudDialog.Close();
    }

    private async Task StartTickSequence(double startRotation, double addedRotation, double totalDurationMs, int sliceCount)
    {
        // A single slice is 360 / count
        double sliceAngle = 360.0 / sliceCount;
        
        // Total final angle
        double endRotation = startRotation + addedRotation;

        // Calculate all boundaries between startRotation and endRotation
        // Because standard CSS rotates modulo 360, every time the total rotation passes a multiple of sliceAngle, it's a boundary.
        
        // We want the smallest multiple of sliceAngle that is greater than startRotation:
        double nextBoundary = Math.Ceiling(startRotation / sliceAngle) * sliceAngle;
        
        List<int> tickDelays = new List<int>();

        while (nextBoundary < endRotation)
        {
            double progress = (nextBoundary - startRotation) / addedRotation;
            
            // Using cubic ease-out inverse: t = duration * (1 - (1 - progress)^(1/3))
            double timeFraction = 1.0 - Math.Pow(1.0 - progress, 1.0 / 3.0);
            int timeMs = (int)(totalDurationMs * timeFraction);
            
            tickDelays.Add(timeMs);
            nextBoundary += sliceAngle;
        }

        // Now wait and play
        int accumulatedTime = 0;
        foreach (var targetTime in tickDelays)
        {
            int delay = targetTime - accumulatedTime;
            if (delay > 0)
            {
                await Task.Delay(delay);
                accumulatedTime += delay;
                
                // Only play if they didn't skip ahead or cancel
                if (!IsAnimating) break; 

                _ = AudioService.PlayTickAsync("tick.mp3");
            }
        }
    }
}