@implements IDisposable
@using TheUsualWheelProject.Models

<div class="collection-container">
    
    <div class="collection-header mt-8 mb-4">
        <div class="collection-actions">
            <button class="action-btn"><MudIcon Icon="@Icons.Material.Filled.Shuffle" Size="Size.Small" /> SHUFFLE</button>
            <button class="action-btn" @onclick="ToggleMassRemoveMode">
                <MudIcon Icon="@(_isMassRemoveMode ? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)" Size="Size.Small" Color="@(_isMassRemoveMode ? Color.Primary : Color.Default)" /> 
                @(_isMassRemoveMode ? "CANCEL REMOVE" : "REMOVE")
            </button>
            @if (_isMassRemoveMode && _selectedForRemoval.Any())
            {
                <button class="action-btn" style="color: #ff5252; border-color: #ff5252;" @onclick="ExecuteMassRemove">
                    <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" /> 
                    REMOVE (@_selectedForRemoval.Count)
                </button>
            }
            <div class="movie-count-badge">
                <span class="count-number">@ActiveMovies.Count()</span>
                <span class="count-label">movies</span>
            </div>
        </div>
    </div>

    <div class="section-container mt-4">
        <div class="section-title mb-3">
            <MudIcon Icon="@Icons.Material.Filled.PlayCircleOutline" Size="Size.Small" Class="mr-2" />
            <span>ACTIVE MOVIES</span>
        </div>

        <div class="movie-list">
            @foreach (WheelMovieItem item in ActiveMovies)
            {
                <MovieCard Title="@item.Movie.Title" 
                           Year="@item.Movie.Year.ToString()"
                           Director="@item.Movie.Director"
                           PosterUrl="@item.Movie.PosterUrl"
                           IsSelected="@_selectedForRemoval.Contains(item)"
                           OnCardClick="@(() => { if (_isMassRemoveMode) ToggleMovieSelection(item); })">
                    <RightActions>
                        @if (_isMassRemoveMode)
                        {
                            <MudIcon Icon="@(_selectedForRemoval.Contains(item) ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)" 
                                     Color="@(_selectedForRemoval.Contains(item) ? Color.Error : Color.Default)" />
                        }
                        else
                        {
                            <MudMenu Icon="@Icons.Material.Rounded.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                <MudMenuItem Icon="@Icons.Material.Outlined.RemoveRedEye" OnClick="@(async () => await ViewModel.ToggleMovieWatchedStatusAsync(item.WheelMovie.Id, true))">Mark as Watched</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(async () => await ViewModel.RemoveWheelMovieAsync(item.WheelMovie.Id))">Remove Movie</MudMenuItem>
                            </MudMenu>
                        }
                    </RightActions>
                </MovieCard>
            }

            <div class="add-movie-btn mt-3" @onclick="() => { }">
                <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="mr-2" />
                <span>ADD MOVIE</span>
            </div>
        </div>
    </div>

    <div class="section-container mt-8">
        <div class="section-title mb-3">
            <MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Small" Class="mr-2" />
            <span>WATCHED MOVIES</span>
        </div>

        <div class="movie-list">
            @foreach (WheelMovieItem item in WatchedMovies)
            {
                <MovieCard Title="@item.Movie.Title" 
                           Year="@item.Movie.Year.ToString()"
                           Director="@item.Movie.Director"
                           PosterUrl="@item.Movie.PosterUrl"
                           IsWatched="true"
                           IsSelected="@_selectedForRemoval.Contains(item)"
                           OnCardClick="@(() => { if (_isMassRemoveMode) ToggleMovieSelection(item); })">
                    <RightActions>
                        @if (_isMassRemoveMode)
                        {
                            <MudIcon Icon="@(_selectedForRemoval.Contains(item) ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)" 
                                     Color="@(_selectedForRemoval.Contains(item) ? Color.Error : Color.Default)" />
                        }
                        else
                        {
                            <MudMenu Icon="@Icons.Material.Rounded.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                <MudMenuItem Icon="@Icons.Material.Filled.RemoveRedEye" OnClick="@(async () => await ViewModel.ToggleMovieWatchedStatusAsync(item.WheelMovie.Id, false))">Unmark as Watched</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(async () => await ViewModel.RemoveWheelMovieAsync(item.WheelMovie.Id))">Remove Movie</MudMenuItem>
                            </MudMenu>
                        }
                    </RightActions>
                </MovieCard>
            }
        </div>
    </div>

</div>

@code {
    [Inject] private TheUsualWheelProject.ViewModels.WheelViewModel ViewModel { get; set; } = default!;

    private bool _isMassRemoveMode = false;
    private HashSet<WheelMovieItem> _selectedForRemoval = new();

    private IEnumerable<WheelMovieItem> ActiveMovies => 
        ViewModel.ActiveSessionMovies ?? Enumerable.Empty<WheelMovieItem>();

    private IEnumerable<WheelMovieItem> WatchedMovies => 
        ViewModel.WatchedMovies ?? Enumerable.Empty<WheelMovieItem>();

    protected override void OnInitialized()
    {
        ViewModel.DataUpdated += StateHasChanged;
    }

    public void Dispose()
    {
        ViewModel.DataUpdated -= StateHasChanged;
    }

    private void ToggleMassRemoveMode()
    {
        _isMassRemoveMode = !_isMassRemoveMode;
        if (!_isMassRemoveMode) _selectedForRemoval.Clear();
    }

    private void ToggleMovieSelection(WheelMovieItem item)
    {
        if (_selectedForRemoval.Contains(item))
            _selectedForRemoval.Remove(item);
        else
            _selectedForRemoval.Add(item);
    }

    private async Task ExecuteMassRemove()
    {
        if (_selectedForRemoval.Any())
        {
            var idsToRemove = _selectedForRemoval.Select(i => i.WheelMovie.Id).ToList();
            await ViewModel.RemoveWheelMoviesAsync(idsToRemove);
        }

        _selectedForRemoval.Clear();
        _isMassRemoveMode = false;
    }
}
