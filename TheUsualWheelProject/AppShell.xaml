<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TheUsualWheelProject.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TheUsualWheelProject"
    xmlns:views="clr-namespace:TheUsualWheelProject.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="The Usual Wheel">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Wheels"
            ContentTemplate="{DataTemplate views:WheelListPage}"
            Route="WheelListPage" />
    </TabBar>

</Shell>